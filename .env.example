# Copy to .env and fill in values. Never commit .env.

# Postgres (local Docker: docker compose up -d)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/uniformdesk?schema=public"

# Railway / managed Postgres example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/railway?sslmode=require"

# Required — use a long random string in production
AUTH_SECRET="replace-with-a-long-random-secret"

# Public site URL for proof links / QR (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional — M-Pesa sandbox credentials (confirmation adapter; not live rails)
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
