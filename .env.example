# Copy to .env and fill in values. Never commit .env.

# SQLite (local / CI)
DATABASE_URL="file:./prisma/dev.db"

# Production: use Postgres instead, e.g.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/uniformdesk?sslmode=require"
# Then follow docs/PRODUCTION.md to switch the Prisma provider.

# Required — use a long random string in production
AUTH_SECRET="replace-with-a-long-random-secret"

# Public site URL for proof links / QR (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional — M-Pesa sandbox credentials (confirmation adapter; not live rails)
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
